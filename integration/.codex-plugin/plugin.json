{
  "name": "agent-sidecar",
  "version": "0.2.0",
  "description": "Agent Sidecar 的接入：把每个会话在做什么（属于哪个窗口、是否在等你批准、屏幕上正在显示的文字）写到本机文件，供 Agent Sidecar 的 VS Code 版和终端版读取。本身不显示界面，不改变 Agent 的行为。",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ],
      "PermissionRequest": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ],
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 3
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 3
            }
          ]
        }
      ]
    }
  }
}
