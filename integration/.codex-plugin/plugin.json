{
  "name": "agent-sidecar",
  "version": "0.1.0",
  "description": "Writes what each session is doing (its window, approvals it waits for, text on screen) to a local file that Agent Sidecar reads. Shows nothing and changes nothing in the agent.",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ],
      "PermissionRequest": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ],
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/hook.mjs\" codex \"$PPID\"",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}
