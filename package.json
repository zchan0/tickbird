{
  "name": "tickbird",
  "displayName": "Tickbird",
  "description": "Read-only, project-scoped process evidence beside Codex and Claude Code.",
  "publisher": "zchan0",
  "version": "0.8.1",
  "private": true,
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "main": "./dist/packages/vscode/src/extension.js",
  "activationEvents": [
    "onView:tickbird.observer"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tickbird.open",
        "title": "Open Process Observer",
        "category": "Tickbird"
      },
      {
        "command": "tickbird.chooseSession",
        "title": "Choose Project Session",
        "category": "Tickbird",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "tickbird.refresh",
        "title": "Refresh Selected Session",
        "category": "Tickbird",
        "icon": "$(refresh)"
      },
      {
        "command": "tickbird.keepEvidence",
        "title": "Keep Evidence Preview",
        "category": "Tickbird"
      },
      {
        "command": "tickbird.coverage",
        "title": "Show Content Coverage Ledger",
        "category": "Tickbird"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tickbird.chooseSession",
          "when": "view == tickbird.observer",
          "group": "navigation@1"
        },
        {
          "command": "tickbird.refresh",
          "when": "view == tickbird.observer",
          "group": "navigation@2"
        },
        {
          "command": "tickbird.coverage",
          "when": "view == tickbird.observer",
          "group": "more@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tickbird",
          "title": "Tickbird",
          "icon": "resources/sidecar.svg"
        }
      ]
    },
    "views": {
      "tickbird": [
        {
          "type": "webview",
          "id": "tickbird.observer",
          "name": "过程"
        }
      ]
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "npm run build && node scripts/launch-development.mjs",
    "package:vscode": "node scripts/install-vscode.mjs --package-only",
    "install:vscode": "npm run build && node scripts/install-vscode.mjs",
    "set-version": "node scripts/set-version.mjs",
    "release": "node scripts/release.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "build:realtime": "tsc -p tsconfig.realtime.json",
    "test:realtime": "npm run build:realtime && node --test .test-artifacts/realtime-build/tests/*.test.js",
    "probe:realtime": "npm run build:realtime && node .test-artifacts/realtime-build/scripts/probe-realtime.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:host": "npm run build && node scripts/test-host.mjs",
    "audit:samples": "npm run build && node dist/scripts/audit-samples.js",
    "verify:content": "npm run build && node dist/scripts/verify-real-content.js",
    "verify:sessions": "npm run build && node dist/scripts/verify-session-granularity.js",
    "test:coexistence": "npm run build && node scripts/test-coexistence.mjs",
    "install:terminal": "npm run build && node scripts/install-terminal.mjs",
    "install:all": "npm run install:vscode && node scripts/install-terminal.mjs",
    "package:terminal": "esbuild packages/terminal/src/cli.ts --bundle --platform=node --format=cjs --target=node22 --minify --legal-comments=none --log-level=warning --outfile=build/tickbird-cli.cjs",
    "bundle:plugin": "esbuild packages/terminal/src/cli.ts --bundle --platform=node --format=cjs --target=node22 --minify --legal-comments=none --log-level=warning --outfile=plugins/tickbird-split/program/tickbird.cjs"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "highlight.js": "11.11.1",
    "markdown-it": "14.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.1",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zchan0/tickbird.git"
  }
}
