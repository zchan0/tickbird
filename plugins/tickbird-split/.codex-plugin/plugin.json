{
  "name": "tickbird-split",
  "version": "0.8.0",
  "description": "Tickbird 终端版：在 kitty 或 tmux 里启动 Agent 时，在旁边开一栏 Tickbird，显示这个会话的过程。自带 Tickbird 程序。需要同时装 tickbird-state。不改变 Agent 的行为。",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"$PLUGIN_ROOT/scripts/split.mjs\" codex \"$PPID\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  },
  "license": "MIT",
  "repository": "https://github.com/zchan0/tickbird"
}
